{
  "schema_version": "0.6",
  "protocol_id": "synthetic_crc_slice",
  "protocol_version": "0.1-synthetic",
  "display_name": "公开合成CRC切片",
  "description": "从零构造的CRC-16完整记录样例，不对应任何真实协议。",
  "source_ref": "SYNTHETIC_FROM_SCRATCH:crc_minimal_public_vector",
  "resource_profile": "desktop",
  "framing_profiles": [
    {
      "id": "complete_record",
      "display_name": "完整记录",
      "description": "固定长度完整记录。",
      "source_ref": "SYNTHETIC_FROM_SCRATCH:crc_minimal_public_vector#framing",
      "input_kind": "complete_record"
    }
  ],
  "pipelines": [
    {
      "id": "synthetic_rx",
      "display_name": "合成接收",
      "description": "公开离线测试Pipeline。",
      "source_ref": "SYNTHETIC_FROM_SCRATCH:crc_minimal_public_vector#pipeline",
      "direction_id": "rx",
      "input_framing_profile_id": "complete_record",
      "message_ids": ["crc_record"]
    }
  ],
  "messages": [
    {
      "id": "crc_record",
      "display_name": "CRC记录",
      "description": "九字节业务载荷、两字节CRC和一个固定尾字节。",
      "source_ref": "SYNTHETIC_FROM_SCRATCH:crc_minimal_public_vector#message",
      "direction_id": "rx",
      "frame_length_bytes": 12,
      "matcher": {
        "all": [
          {"kind": "frame_length_equals", "length_bytes": 12},
          {"kind": "fixed_bytes", "byte_offset": 11, "bytes": "AA"}
        ]
      },
      "integrity": {
        "algorithm": "crc",
        "parameters": {
          "width": 16,
          "poly": "1021",
          "init": "FFFF",
          "refin": false,
          "refout": false,
          "xorout": "0000"
        },
        "range": {"byte_offset": 0, "byte_length": 9},
        "storage": {"byte_offset": 9, "byte_order": "big_endian"}
      },
      "fields": [
        {
          "id": "payload",
          "display_name": "载荷",
          "description": "标准检查输入123456789。",
          "source_ref": "SYNTHETIC_FROM_SCRATCH:crc_minimal_public_vector#payload",
          "value_type": "BYTES",
          "wire": {"codec": "bytes", "byte_offset": 0, "byte_length": 9},
          "encode": {"source": "input"}
        }
      ]
    }
  ]
}
