{
  "schema_version": "0.9",
  "protocol_id": "synthetic_binary_ui_stage1",
  "protocol_version": "1.0-public",
  "display_name": "Public Binary Host UI stage 1",
  "description": "From-scratch complete-record Binary UI fixture with owned typed results and physical mappings.",
  "source_ref": "SYNTHETIC_FROM_SCRATCH:binary_ui_stage1",
  "resource_profile": "desktop",
  "framing_profiles": [{
    "id": "record", "display_name": "Complete record", "description": "Complete-record input only.",
    "source_ref": "SYNTHETIC_FROM_SCRATCH:binary_ui_stage1#framing", "input_kind": "complete_record"
  }],
  "pipelines": [{
    "id": "ui_pipeline", "display_name": "Typed UI pipeline", "description": "All supported stage-one result types.",
    "source_ref": "SYNTHETIC_FROM_SCRATCH:binary_ui_stage1#pipeline", "direction_id": "synthetic",
    "input_framing_profile_id": "record", "message_ids": ["typed_record"]
  }, {
    "id": "alternate_pipeline", "display_name": "Alternate pipeline", "description": "Independent complete-record binding.",
    "source_ref": "SYNTHETIC_FROM_SCRATCH:binary_ui_stage1#alternate_pipeline", "direction_id": "synthetic",
    "input_framing_profile_id": "record", "message_ids": ["alternate_record"]
  }],
  "messages": [{
    "id": "typed_record", "display_name": "Typed record", "description": "BOOL, ENUM, UINT, INT, BYTES and converted DECIMAL64.",
    "source_ref": "SYNTHETIC_FROM_SCRATCH:binary_ui_stage1#message", "direction_id": "synthetic",
    "frame_length_bytes": 10,
    "matcher": {"all": [{"kind": "frame_length_equals", "length_bytes": 10}]},
    "bit_containers": [
      {"id": "be_lsb", "container_offset": 0, "container_width": 2, "byte_order": "big_endian", "bit_numbering": "lsb0", "base_value": 32776},
      {"id": "le_msb", "container_offset": 2, "container_width": 2, "byte_order": "little_endian", "bit_numbering": "msb0", "base_value": 3}
    ],
    "fields": [
      {"id": "enabled", "display_name": "Enabled", "description": "BOOL without a separately observed raw integer.", "source_ref": "SYNTHETIC:binary_ui#enabled", "value_type": "BOOL", "wire": {"codec": "bitfield", "container_id": "be_lsb", "bit_offset": 0, "bit_width": 1}, "encode": {"source": "input"}},
      {"id": "mode", "display_name": "Mode", "description": "Known and preserved-unknown enum.", "source_ref": "SYNTHETIC:binary_ui#mode", "value_type": "ENUM", "wire": {"codec": "bitfield", "container_id": "be_lsb", "bit_offset": 1, "bit_width": 2}, "encode": {"source": "input"}, "unknown_enum_policy": "preserve", "enum_entries": [{"id": "idle", "display_name": "Idle", "raw_value": 0}, {"id": "active", "display_name": "Active", "raw_value": 2}]},
      {"id": "cross_bits", "display_name": "Cross bits", "description": "Cross-byte big-endian LSB0 UINT.", "source_ref": "SYNTHETIC:binary_ui#cross", "value_type": "UINT64", "wire": {"codec": "bitfield", "container_id": "be_lsb", "bit_offset": 4, "bit_width": 8}, "encode": {"source": "input"}},
      {"id": "msb_bits", "display_name": "MSB bits", "description": "Cross-byte little-endian MSB0 UINT.", "source_ref": "SYNTHETIC:binary_ui#msb", "value_type": "UINT64", "wire": {"codec": "bitfield", "container_id": "le_msb", "bit_offset": 1, "bit_width": 9}, "encode": {"source": "input"}},
      {"id": "count", "display_name": "Count", "description": "Direct UINT.", "source_ref": "SYNTHETIC:binary_ui#count", "value_type": "UINT64", "wire": {"codec": "unsigned_integer", "byte_offset": 4, "byte_width": 1}, "encode": {"source": "input"}},
      {"id": "delta", "display_name": "Delta", "description": "Direct INT.", "source_ref": "SYNTHETIC:binary_ui#delta", "value_type": "INT64", "wire": {"codec": "unsigned_integer", "byte_offset": 5, "byte_width": 1}, "encode": {"source": "input"}},
      {"id": "payload", "display_name": "Payload", "description": "Two-byte payload.", "source_ref": "SYNTHETIC:binary_ui#payload", "value_type": "BYTES", "wire": {"codec": "bytes", "byte_offset": 6, "byte_length": 2}, "encode": {"source": "input"}},
      {"id": "temperature", "display_name": "Temperature", "description": "Logical DECIMAL64 with observed signed raw.", "source_ref": "SYNTHETIC:binary_ui#temperature", "value_type": "INT64", "wire": {"codec": "unsigned_integer", "byte_offset": 8, "byte_width": 1}, "encode": {"source": "input"}, "conversion": {"kind": "linear", "output_type": "DECIMAL64", "scale": {"numerator": 1, "denominator": 1}, "bias": {"numerator": 0, "denominator": 1}}},
      {"id": "marker", "display_name": "Marker", "description": "Read-only constant.", "source_ref": "SYNTHETIC:binary_ui#marker", "value_type": "UINT64", "wire": {"codec": "unsigned_integer", "byte_offset": 9, "byte_width": 1}, "encode": {"source": "constant", "value": 90}}
    ]
  }, {
    "id": "alternate_record", "display_name": "Alternate record", "description": "Small independent complete record.",
    "source_ref": "SYNTHETIC_FROM_SCRATCH:binary_ui_stage1#alternate", "direction_id": "synthetic",
    "frame_length_bytes": 2,
    "matcher": {"all": [{"kind": "frame_length_equals", "length_bytes": 2}, {"kind": "fixed_bytes", "byte_offset": 0, "bytes": "C3"}]},
    "fields": [{"id": "alternate_value", "display_name": "Alternate value", "description": "Second binding value.", "source_ref": "SYNTHETIC:binary_ui#alternate_value", "value_type": "UINT64", "wire": {"codec": "unsigned_integer", "byte_offset": 1, "byte_width": 1}, "encode": {"source": "input"}}]
  }]
}
