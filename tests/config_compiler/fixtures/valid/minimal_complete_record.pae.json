{
  "schema_version": "0.1",
  "protocol_id": "synthetic_minimal_protocol",
  "protocol_version": "0.1-synthetic",
  "display_name": "最小完整记录协议",
  "description": "仅用于配置编译语料。",
  "source_ref": "SYNTHETIC:minimal_complete_record",
  "resource_profile": "desktop",
  "framing_profiles": [
    {
      "id": "complete_record",
      "display_name": "完整记录",
      "description": "单次输入就是完整记录。",
      "source_ref": "SYNTHETIC:minimal_complete_record#framing",
      "input_kind": "complete_record"
    }
  ],
  "pipelines": [
    {
      "id": "source_to_sink",
      "display_name": "源到目标",
      "description": "单方向Pipeline。",
      "source_ref": "SYNTHETIC:minimal_complete_record#pipeline",
      "direction_id": "source_to_sink",
      "input_framing_profile_id": "complete_record",
      "message_ids": ["minimal_message"]
    }
  ],
  "messages": [
    {
      "id": "minimal_message",
      "display_name": "最小消息",
      "description": "四字节人工消息。",
      "source_ref": "SYNTHETIC:minimal_complete_record#message",
      "direction_id": "source_to_sink",
      "frame_length_bytes": 4,
      "matcher": {
        "all": [
          {"kind": "frame_length_equals", "length_bytes": 4},
          {"kind": "fixed_bytes", "byte_offset": 2, "bytes": "00 01"}
        ]
      },
      "fields": [
        {
          "id": "payload_word",
          "display_name": "载荷字",
          "description": "动态无符号整数。",
          "source_ref": "SYNTHETIC_FROM_SCRATCH:minimal_complete_record#payload",
          "value_type": "UINT64",
          "wire": {
            "codec": "unsigned_integer",
            "byte_offset": 0,
            "byte_width": 2,
            "byte_order": "big_endian"
          },
          "encode": {"source": "input"}
        },
        {
          "id": "message_type",
          "display_name": "消息类型",
          "description": "固定类型1。",
          "source_ref": "SYNTHETIC_FROM_SCRATCH:minimal_complete_record#type",
          "value_type": "UINT64",
          "wire": {
            "codec": "unsigned_integer",
            "byte_offset": 2,
            "byte_width": 2,
            "byte_order": "big_endian"
          },
          "encode": {"source": "constant", "value": 1}
        }
      ]
    }
  ]
}
