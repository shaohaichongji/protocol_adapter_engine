{
  "schema_version": "0.1",
  "protocol_id": "synthetic_field_overlap",
  "protocol_version": "0.1-synthetic",
  "display_name": "字段重叠用例",
  "source_ref": "SYNTHETIC:domain_field_overlap",
  "resource_profile": "desktop",
  "framing_profiles": [
    {
      "id": "complete_record",
      "display_name": "完整记录",
      "description": "测试Framing。",
      "source_ref": "SYNTHETIC:domain_field_overlap#framing",
      "input_kind": "complete_record"
    }
  ],
  "pipelines": [
    {
      "id": "source_to_sink",
      "display_name": "源到目标",
      "description": "单方向Pipeline。",
      "source_ref": "SYNTHETIC:domain_field_overlap#pipeline",
      "direction_id": "source_to_sink",
      "input_framing_profile_id": "complete_record",
      "message_ids": ["minimal_message"]
    }
  ],
  "messages": [
    {
      "id": "minimal_message",
      "display_name": "重叠字段消息",
      "description": "两个字段区间分别为[0,2)和[1,3)。",
      "source_ref": "SYNTHETIC:domain_field_overlap#message",
      "direction_id": "source_to_sink",
      "frame_length_bytes": 4,
      "matcher": {"all": [{"kind": "frame_length_equals", "length_bytes": 4}]},
      "fields": [
        {
          "id": "first_word",
          "display_name": "第一个字",
          "description": "区间[0,2)。",
          "source_ref": "SYNTHETIC:domain_field_overlap#first",
          "value_type": "UINT64",
          "wire": {"codec": "unsigned_integer", "byte_offset": 0, "byte_width": 2, "byte_order": "big_endian"},
          "encode": {"source": "input"}
        },
        {
          "id": "second_word",
          "display_name": "第二个字",
          "description": "区间[1,3)，与第一个字段重叠。",
          "source_ref": "SYNTHETIC:domain_field_overlap#second",
          "value_type": "UINT64",
          "wire": {"codec": "unsigned_integer", "byte_offset": 1, "byte_width": 2, "byte_order": "big_endian"},
          "encode": {"source": "input"}
        }
      ]
    }
  ]
}
